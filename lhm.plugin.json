        "type": "object",
        "properties": {
          "material": {
            "type": "string",
            "enum": [
              "cu",
              "al"
            ],
            "default": "cu",
            "description": "Conductor. \"cu\" = Copper; \"al\" = Aluminum."
          },
          "temp": {
            "type": "string",
            "enum": [
              "60",
              "75",
              "90"
            ],
            "default": "75",
            "description": "Termination rating. \"60\" = 60\u00b0C (NM-B, UF); \"75\" = 75\u00b0C (THHN in conduit); \"90\" = 90\u00b0C."
          },
          "amps": {
            "type": "number",
            "minimum": 1,
            "default": 60,
            "description": "Breaker / load (A)."
          },
          "volts": {
            "type": "string",
            "enum": [
              "120",
              "208",
              "240",
              "277",
              "480"
            ],
            "default": "240",
            "description": "Voltage. \"120\" = 120 V; \"208\" = 208 V; \"240\" = 240 V; \"277\" = 277 V; \"480\" = 480 V."
          },
          "phase": {
            "type": "string",
            "enum": [
              "1",
              "3"
            ],
            "default": "1",
            "description": "Phase. \"1\" = Single-phase; \"3\" = Three-phase."
          },
          "feet": {
            "type": "number",
            "minimum": 1,
            "default": 150,
            "description": "One-way distance (ft)."
          },
          "limit": {
            "type": "number",
            "minimum": 0.5,
            "default": 3,
            "description": "Max voltage drop (%)."
          }
